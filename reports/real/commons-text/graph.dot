digraph dependencies {
  rankdir=LR;
  graph [bgcolor="#f5f7fb", pad="0.4"];
  node [shape=box, style="rounded,filled", fillcolor="#e0edff", fontname="Arial"];
  edge [color="#64748b"];
  "org.apache.commons:commons-text:1.12.0" [fillcolor="#99d9c8", penwidth=2];
  "org.apache.commons:commons-lang3:3.14.0";
  "org.apache.commons:commons-text:1.12.0" -> "org.apache.commons:commons-lang3:3.14.0";
}
